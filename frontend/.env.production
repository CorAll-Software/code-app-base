VITE_PUBLIC_URL=https://app.midominio.com

VITE_API_URL=https://api.midominio.com/api/
VITE_WS_URL=wss://api.midominio.com/ws/

# Cap · CAPTCHA autoalojado. Endpoint público con barra final:
# https://<instancia-cap>/<site-key>/  · Dejar vacío para desactivar.
VITE_CAP_API_ENDPOINT=

# Analítica opcional (Umami). Dejar vacío para desactivar.
VITE_UMAMI_SCRIPT_URL=
VITE_UMAMI_WEBSITE_ID=

# Sentry · reporte de errores (instancia autoalojada). Mismo DSN que el backend
# (SENTRY_DSN): el DSN no es un secreto, solo autoriza a ENVIAR eventos.
# Vacío = desactivado. Nunca se activa en localhost, aunque esté relleno.
# Formato: https://<clave-publica>@<host-de-la-instancia>/<id-de-proyecto>
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=production

# Subida de sourcemaps: sin ella los stacks del navegador llegan minificados e
# ilegibles. Estas tres son tan públicas como el DSN. La cuarta,
# SENTRY_AUTH_TOKEN, NO va aquí: autoriza a ESCRIBIR en la instancia y este
# fichero se versiona — va en el `.env` local (gitignore) o por entorno al
# construir. Hacen falta las cuatro; si falta una, no se sube nada.
SENTRY_URL=
SENTRY_ORG=
SENTRY_PROJECT=
