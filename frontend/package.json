{
  "name": "app-base-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "bun": ">=1.4.0",
    "node": ">=22"
  },
  "scripts": {
    "dev": "bunx --bun vite",
    "build": "bunx tsc && bunx --bun vite build",
    "build:qas": "bunx tsc && bunx --bun vite build --mode qas",
    "build:prod": "bunx tsc && bunx --bun vite build --mode production",
    "preview": "vite preview"
  },
  "dependencies": {
    "@ant-design/icons": "6.3.4",
    "@sentry/react": "10.75.0",
    "antd": "6.6.4",
    "cap-widget": "0.1.57",
    "dayjs": "1.11.23",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-highlight-words": "0.21.0",
    "react-router-dom": "7.18.4",
    "sass": "1.104.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@sentry/vite-plugin": "5.4.0",
    "@vitejs/plugin-react-swc": "4.3.3",
    "rollup-plugin-analyzer": "4.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vite-plugin-html": "3.2.2"
  },
  "packageManager": "bun@1.4.0"
}
