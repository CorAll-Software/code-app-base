{
  "name": "app-base-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "bun": "1.3.5",
    "node": "22.21.1"
  },
  "scripts": {
    "dev": "bunx --bun vite",
    "build": "bunx tsc && bunx --bun vite build",
    "build:qas": "bunx tsc && bunx --bun vite build --mode qas",
    "build:prod": "bunx tsc && bunx --bun vite build --mode production",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview"
  },
  "dependencies": {
    "@ant-design/icons": "6.3.1",
    "@ant-design/plots": "2.6.8",
