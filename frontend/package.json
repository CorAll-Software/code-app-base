    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "antd": "6.4.5",
    "canvas-confetti": "1.9.4",
    "chart.js": "4.5.1",
    "chartjs-plugin-annotation": "3.1.0",
    "chartjs-plugin-zoom": "2.2.0",
    "dayjs": "1.11.21",
    "exceljs": "4.4.0",
    "file-saver": "2.0.5",
    "html2canvas": "1.4.1",
    "jspdf": "4.2.1",
    "jspdf-autotable": "5.0.8",
    "leaflet": "^1.9.4",
    "md-editor-rt": "6.5.3",
