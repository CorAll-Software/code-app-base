{
  "name": "app-base-backend",
  "version": "0.1.0",
  "engines": {
    "bun": "1.3.5",
    "node": "22.21.1"
  },
  "scripts": {
    "start": "bun build/main.js",
    "dev": "bun run --watch --watch-path src src/index.ts",
    "build": "bun build src/index.ts --target=bun --outfile=build/main.js",
    "new-password": "bun run src/utils/new-password.ts",
    "tsc": "bunx tsc --noEmit"
  },
  "dependencies": {
    "@elysiajs/cors": "1.4.2",
    "@elysiajs/openapi": "1.4.15",
    "dotenv": "17.4.2",
    "elysia": "1.4.29",
    "exceljs": "4.4.0",
    "jsonwebtoken": "9.0.3",
    "nodemailer": "9.0.1",
    "sharp": "^0.35.3",
    "xlsx": "0.18.5"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "9.0.10",
    "@types/nodemailer": "8.0.1",
    "bun-types": "latest"
  },
  "module": "src/index.js",
  "packageManager": "bun@1.3.9"
}
