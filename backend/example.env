# Servicio
PORT=3000
TEAM_NAME="Mi Empresa"
TZ="America/Lima"

# Red · orígenes, proxies y cookies
DOMAIN_FRONTEND=http://localhost:5004
# Otros orígenes del navegador que pueden llamar a la API, separados por comas.
# DOMAIN_FRONTEND ya está incluido. Ej.: https://qas-app.midominio.com
CORS_ORIGINS=
# Proxies delante del backend que agregan X-Forwarded-For. De ahí sale la ip
# de la bitácora y de las sesiones. 2 = Cloudflare → Traefik (Dokploy); sirve
# también sin Cloudflare. Exige que Traefik confíe solo en los rangos de
# Cloudflare (ver docs/checklist-nuevo-proyecto.md). 0 = sin proxy: ip vacía.
TRUSTED_PROXY_HOPS=2
# Cookies de sesión con Secure. Vacío = según DOMAIN_FRONTEND: https → sí,
# http (desarrollo local) → no. Solo hace falta para forzarlo (true/false).
COOKIE_SECURE=

# Sesión · access corto + refresh rotativo (segundos)
# JWT_SECRET es obligatorio (mínimo 32 caracteres): sin él el backend no arranca.
# Generar uno con Bun: bun -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_ACCESS_EXPIRE_IN=900 # 15 minutos
JWT_REFRESH_EXPIRE_IN=604800 # 7 días
# Días que se conservan en BD las sesiones ya cerradas (job de purga).
SESSION_RETENTION_DAYS=30

# Base de datos · PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=app_base
DB_USER=postgres
DB_PASSWORD=
DB_MAX_POOL_SIZE=10

# Redis · Valkey
REDIS_URL=redis://localhost:6379

# Correo · SMTP
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=
EMAIL_PASSWORD=

# Archivos · AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=app-base-private
AWS_S3_BUCKET_NAME_PUBLIC=app-base-public
AWS_S3_BASE_URL=
AWS_S3_EXPIRES_IN=3600

# Sentry · reporte de errores (instancia autoalojada)
# Mismo DSN que el frontend (VITE_SENTRY_DSN): el DSN no es un secreto, solo
# autoriza a ENVIAR eventos. Vacío = reporte desactivado.
# Formato: https://<clave-publica>@<host-de-la-instancia>/<id-de-proyecto>
SENTRY_DSN=
# Entorno que se ve en Sentry. Si no se define se toma NODE_ENV, y con
# "development" el reporte queda apagado aunque haya DSN.
SENTRY_ENVIRONMENT=
# Nombre del servidor que acompaña a cada evento (opcional).
SENTRY_SERVER_NAME=
SENTRY_TIMEOUT_MS=5000

# Cap · CAPTCHA autoalojado (https://trycap.dev)
# Endpoint público de la instancia, con barra final: https://<instancia-cap>/<site-key>/
# Si CAP_API_ENDPOINT o CAP_SECRET_KEY quedan vacíos, el CAPTCHA se desactiva.
CAP_API_ENDPOINT=
CAP_SECRET_KEY=
CAP_TIMEOUT_MS=8000
