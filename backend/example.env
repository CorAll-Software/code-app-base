# Service
PORT=3000
TEAM_NAME="Mi Empresa"

DOMAIN_FRONTEND=http://localhost:5004

# Tokens · access corto + refresh rotativo (segundos)
# Generar token JWT con Bunjs: bun -e "import { randomBytes } from 'bun:crypto'; console.log(randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_ACCESS_EXPIRE_IN=900 # 15 minutos
JWT_REFRESH_EXPIRE_IN=604800 # 7 días
# Días que se conservan en BD las sesiones ya cerradas (job de purga).
SESSION_RETENTION_DAYS=30

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=app_base
DB_USER=postgres
DB_PASSWORD=
DB_MAX_POOL_SIZE=10

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=
EMAIL_PASSWORD=

# AWS S3 / MinIO Configuration
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=app-base-private
AWS_S3_BUCKET_NAME_PUBLIC=app-base-public
AWS_S3_BASE_URL=
AWS_S3_EXPIRES_IN=3600

# Redis Configuration (Valkey)
REDIS_URL=redis://localhost:6379

# Cap · CAPTCHA autoalojado (https://trycap.dev)
# Endpoint público de la instancia, con barra final: https://<instancia-cap>/<site-key>/
# Si CAP_API_ENDPOINT o CAP_SECRET_KEY quedan vacíos, el CAPTCHA se desactiva.
CAP_API_ENDPOINT=
CAP_SECRET_KEY=
CAP_TIMEOUT_MS=8000
